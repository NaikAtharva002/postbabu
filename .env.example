# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postbabu?schema=public"

# Redis URL for BullMQ Job Scheduling
REDIS_URL="redis://localhost:6379"

# Google Gemini API Key for Hinglish / Indian Festival Copy
GEMINI_API_KEY="your-gemini-api-key"

# Meta Graph API (Instagram & Facebook)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# LinkedIn OAuth API
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# WhatsApp Cloud API (For Zero-Login Client Approvals)
WHATSAPP_TOKEN="your-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-id"

# App Public URL (For Magic Links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token Encryption Secret (AES-256)
TOKEN_ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
